# másold .env-be és töltsd ki

# fake | ollama | gemini
# embedding váltása után újra kell indexelni (python -m scripts.ingest)
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# kulcs: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# minimal | low | medium | high | üres
GEMINI_THINKING_LEVEL=low

# dockerben a compose felülírja
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_NUM_CTX=4096
# hogy ne kelljen a 4 GB VRAM-ba férnie az LLM mellé
OLLAMA_EMBEDDING_ON_CPU=true

LLM_TIMEOUT_S=60
# lokálisan 1, Geminivel lehet több
LLM_MAX_CONCURRENCY=1
LLM_MAX_QUEUE=8
LLM_QUEUE_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_S=1.0

RETRIEVAL_TOP_K=4
KEYWORD_SEARCH=true
RETRIEVAL_CANDIDATES=20
# küszöbök bge-m3-hoz; Geminivel: MIN_SCORE=0.70, KEYWORD_MIN_SCORE=0.65 (README 7.1)
MIN_SCORE=0.55
KEYWORD_MIN_SCORE=0.45
MAX_QUESTION_CHARS=500

INDEX_DIR=data/index
LOG_LEVEL=INFO
